{
  "name": "pouquissimas",
  "version": "0.1.0",
  "private": true,
  "description": "Loja virtual da POUQUÍSSIMAS — Next.js, português e preços em BRL.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "placeholders": "python3 scripts/generate_placeholders.py",
    "brand-assets": "python3 scripts/import_brand_assets.py",
    "cf:dev": "wrangler dev --config infra/cloudflare/wrangler.jsonc",
    "cf:deploy": "wrangler deploy --config infra/cloudflare/wrangler.jsonc",
    "cf:test": "node infra/cloudflare/worker.test.mjs",
    "test:redirect": "node --test src/features/auth/safe-redirect.test.ts"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "typescript": "^5.9"
  }
}
